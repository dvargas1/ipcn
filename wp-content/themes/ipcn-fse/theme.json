{
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "navy", "color": "#0d176b", "name": "Navy IPCN" },
        { "slug": "ink", "color": "#0f172a", "name": "Ink" },
        { "slug": "muted", "color": "#e2e8f0", "name": "Muted" },
        { "slug": "ocre", "color": "#c9a86a", "name": "Ocre Afro" },
        { "slug": "base", "color": "#ffffff", "name": "Base" },
        { "slug": "subtle", "color": "#f8fafc", "name": "Subtle" },
        { "slug": "body", "color": "#475569", "name": "Body" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "fontFamily": "\"Oswald\", sans-serif", "slug": "oswald", "name": "Oswald" },
        { "fontFamily": "\"Inter\", \"Open Sans\", sans-serif", "slug": "body", "name": "Body" }
      ],
      "fluid": true
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "blockGap": "1.5rem"
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1100px"
    },
    "custom": {
      "radius": "14px",
      "shadow": "0 6px 20px rgba(13,23,107,.08)",
      "shadowHover": "0 12px 32px rgba(13,23,107,.14)"
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "18px", "lineHeight": "1.6" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--oswald)", "fontWeight": "600" }, "color": { "text": "var(--wp--preset--color--ink)" } },
      "link": { "color": { "text": "var(--wp--preset--color--navy)" } }
    }
  },
  "customTemplates": [
    { "name": "front-page", "title": "Front Page", "postTypes": ["page"] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
